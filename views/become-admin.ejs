<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Become Admin</title>
</head>

<body>

    <h1>Become an Admin</h1>

    <% if (errors && errors.length > 0) { %>

        <ul>
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>

    <% } %>

    <form action="/become-admin" method="POST">

        <label for="passcode">
            Admin Passcode
        </label>

        <input
            type="password"
            id="passcode"
            name="passcode"
            required
        >

        <button type="submit">
            Become Admin
        </button>

    </form>

    <a href="/">
        Back to Home
    </a>

</body>
</html>