<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clubhouse</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        nav {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .nav-inner {
            width: min(800px, 92%);
            margin: 0 auto;
            height: 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .blurred {
                filter: blur(5px);
                user-select: none;
        }
        .brand {
            font-size: 1.125rem;
            font-weight: 700;
            color: #0f m172a;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: #475569;
        }

        .badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            background: #e2e8f0;
            color: #334155;
        }

        .badge-member {
            background: #dcfce7;
            color: #166534;
        }

        .nav-link {
            color: #475569;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: color 0.15s ease;
        }

        .nav-link:hover {
            color: #0f172a;
        }

        .btn {
            display: inline-block;
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            text-decoration: none;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-primary {
            background: #0f172a;
            color: #ffffff;
        }

        .btn-primary:hover {
            background: #1e293b;
        }

        .btn-secondary {
            background: #ffffff;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        .btn-secondary:hover {
            background: #f1f5f9;
            border-color: #94a3b8;
        }

        main {
            width: min(800px, 92%);
            margin: 2rem auto 4rem auto;
            flex: 1;
        }

        .welcome-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .welcome-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .welcome-desc {
            font-size: 0.875rem;
            color: #475569;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: 1.125rem;
            font-weight: 700;
            color: #0f172a;
        }

        .count {
            font-size: 0.8125rem;
            color: #64748b;
            font-weight: 500;
        }

        .message-list {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
        }

        .message-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1.25rem 1.5rem;
        }

        .message-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
            font-size: 0.8125rem;
        }

        .author-name {
            font-weight: 600;
            color: #0f172a;
        }

        .date {
            color: #64748b;
        }

        .message-title {
            font-size: 1.0625rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.5rem;
        }

        .message-body {
            color: #334155;
            font-size: 0.9375rem;
            line-height: 1.6;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .empty-state {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 3rem 1.5rem;
            text-align: center;
            color: #64748b;
            font-size: 0.9375rem;
        }
    </style>
</head>
<body>

    <nav>
        <div class="nav-inner">
            <a href="/" class="brand">Clubhouse</a>

            <div class="nav-links">
                <% if (user) { %>
                    <div class="user-info">
                        <span><%= user.first_name %></span>
                        <% if (user.is_member) { %>
                            <span class="badge badge-member">Member</span>
                        <% } else { %>
                            <span class="badge">Guest</span>
                        <% } %>
                    </div>
                    <a href="/log-out" class="nav-link">Log Out</a>
                <% } else { %>
                    <a href="/log-in" class="nav-link">Log In</a>
                    <a href="/sign-up" class="btn btn-primary">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main>
        <% if (user) { %>
            <section class="welcome-card">
                <div>
                    <h1 class="welcome-title">Welcome, <%= user.first_name %>!</h1>
                    <% if (user.is_member) { %>
                        <p class="welcome-desc">You are a full member. You can view all authors and post new messages.</p>
                    <% } else { %>
                        <p class="welcome-desc">You are currently a guest. Enter the club passcode to become a full member.</p>
                    <% } %>
                </div>

                <div>
                    <% if (user.is_member) { %>
                        <a class="btn btn-primary" href="/new-message">New Message</a>
                    <% } else { %>
                        <a class="btn btn-primary" href="/join-club">Join the Club</a>
                    <% } %>
                </div>
            </section>
        <% } %>

        <div class="section-header">
            <h2 class="section-title">Messages</h2>
            <span class="count"><%= messages.length %> <%= messages.length === 1 ? 'message' : 'messages' %></span>
        </div>

        <% if (messages.length > 0) { %>
            <div class="message-list">
                <% messages.forEach(message => { %>
    <article class="message-card">

        <div class="message-header">

            <% if (user && user.is_member) { %>

                <span class="author-name">
                    <%= message.first_name %> <%= message.last_name %>
                </span>

                <time class="date">
                    <%= message.created_at %>
                </time>

            <% } else { %>

                <span class="author-name blurred">
                    <%= message.first_name %> <%= message.last_name %>
                </span>

                <time class="date blurred">
                    <%= message.created_at %>
                </time>

            <% } %>

        </div>

        <h3 class="message-title">
            <%= message.title %>
        </h3>

        <p class="message-body">
            <%= message.message %>
        </p>

    </article>
<% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <p>No messages yet.</p>
            </div>
        <% } %>
    </main>

</body>
</html>