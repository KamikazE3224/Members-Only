<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join the Club &bull; Clubhouse</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            line-height: 1.6;
        }

        .card {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 2rem;
        }

        .title {
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-size: 0.875rem;
            color: #475569;
            margin-bottom: 1.5rem;
        }

        .errors-box {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 6px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.25rem;
            list-style-position: inside;
        }

        .error-item {
            color: #991b1b;
            font-size: 0.875rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        .input {
            width: 100%;
            padding: 0.65rem 0.75rem;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 0.9375rem;
            font-family: inherit;
            color: #0f172a;
            outline: none;
            transition: border-color 0.15s ease;
        }

        .input:focus {
            border-color: #0f172a;
        }

        .btn-submit {
            width: 100%;
            padding: 0.7rem 1rem;
            background: #0f172a;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .btn-submit:hover {
            background: #1e293b;
        }

        .footer {
            margin-top: 1.5rem;
            text-align: center;
            border-top: 1px solid #e2e8f0;
            padding-top: 1rem;
        }

        .link {
            color: #475569;
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .link:hover {
            color: #0f172a;
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <div class="card">
        <h1 class="title">Join the Club</h1>
        <p class="subtitle">Enter the secret passcode to become a verified member.</p>

        <% if (errors && errors.length > 0) { %>
            <ul class="errors-box">
                <% errors.forEach(error => { %>
                    <li class="error-item"><%= error.msg %></li>
                <% }); %>
            </ul>
        <% } %>

        <form action="/join-club" method="POST">
            <div class="form-group">
                <label class="label" for="passcode">Club Passcode</label>
                <input
                    class="input"
                    type="password"
                    id="passcode"
                    name="passcode"
                    placeholder="Enter passcode"
                    required
                    autofocus
                >
            </div>

            <button class="btn-submit" type="submit">Join Club</button>
        </form>

        <div class="footer">
            <a class="link" href="/">Back to Home</a>
        </div>
    </div>

</body>
</html>